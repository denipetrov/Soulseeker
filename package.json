{
  "name": "soulseeker",
  "version": "0.1.0",
  "description": "Backend for the Rankwarden front end: reads the ladders, looks players up on demand",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run",
    "test:cov": "vitest run --project unit --coverage",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:up:standalone": "docker compose --profile standalone up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:logs": "docker compose logs -f",
    "redis:cli": "docker compose exec redis redis-cli",
    "docker:build": "node scripts/docker-build.mjs",
    "docker:up": "docker compose --profile app up -d",
    "docker:down": "docker compose --profile app down",
    "docker:logs": "docker compose logs -f app",
    "config:check": "node --env-file-if-exists=.env dist/config-check.main.js",
    "keys:generate": "node scripts/generate-oidc-keys.mjs"
  },
  "dependencies": {
    "@denipetrov/blizz-auth": "^0.1.1",
    "@denipetrov/spirit-link": "^0.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "got": "^16.0.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "oidc-provider": "^9.12.2",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.1",
    "@types/oidc-provider": "^9.12.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
