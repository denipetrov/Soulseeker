# Soulseeker production configuration: non-secret settings only. Rendered into
# the ConfigMap; a credential in this file fails the render. Secrets live in
# the `soulseeker-app` Secret (see values.yaml). Validated in CI with
# `node --env-file=deploy/helm/soulseeker/env/production.env dist/config-check.main.js`.

NODE_ENV=production
PORT=3001
LOG_LEVEL=log
# One proxy hop: the gateway.
TRUST_PROXY_HOPS=1

MONGODB_DB=rankwarden

REDIS_KEY_PREFIX=ss:

BLIZZARD_REGION=us
BLIZZARD_REGIONS=us,eu,kr,tw
BLIZZARD_LOCALE=en_US
BLIZZARD_REQUEST_TIMEOUT_MS=10000
BLIZZARD_RETRY_LIMIT=1
BLIZZARD_HOURLY_LIMIT=36000
BLIZZARD_PER_SECOND_LIMIT=100
BLIZZARD_UTILISATION=0.9

RAIDERIO_REGIONS=us,eu,kr,tw,cn
RAIDERIO_REQUEST_TIMEOUT_MS=10000
RAIDERIO_RETRY_LIMIT=1
RAIDERIO_MINUTE_LIMIT=1000
RAIDERIO_UTILISATION=0.9

BUDGET_WAIT_MS=2000

RANKWARDEN_BASE_URL=http://rankwarden.rankwarden.svc.cluster.local:3000
RANKWARDEN_TIMEOUT_MS=10000
RANKWARDEN_SYNC_RETRY_LIMIT=3
RANKWARDEN_SYNC_RETRY_BASE_MS=5000

OIDC_ISSUER=https://api.rankwarden.gg/oidc
OIDC_CLIENT_ID=soulseeker-web
OIDC_API_RESOURCE=https://api.rankwarden.gg
OIDC_ACCESS_TOKEN_TTL_SECONDS=600
OIDC_REFRESH_TOKEN_TTL_SECONDS=43200
OIDC_SESSION_MAX_SECONDS=2592000
CORS_ORIGINS=https://rankwarden.gg

TURNSTILE_ENABLED=false

RATE_LIMIT_TOKEN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_API_IP_PER_MINUTE=600

CACHE_DEFAULT_TTL_SECONDS=300
CACHE_CHARACTER_TTL_SECONDS=900
SEARCH_CACHE_TTL_SECONDS=60
