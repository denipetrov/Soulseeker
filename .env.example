# Soulseeker configuration. Every variable is validated at start
# (src/config/env.schema.ts); `npm run config:check` validates without starting.
# Values shown are the defaults unless marked required.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
# error | warn | log | debug | verbose (cumulative)
LOG_LEVEL=log
# Proxy hops whose X-Forwarded-For is trusted: 1 behind the cluster gateway.
TRUST_PROXY_HOPS=0

# --- MongoDB (read-only, Rankwarden's database) -------------------------------
# Required. In the cluster: the rankwarden_backend user, credentials in the URI.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=rankwarden
MONGODB_SOCKET_TIMEOUT_MS=30000

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ss:

# --- Blizzard (Soulseeker's own client: its own quota) ------------------------
# Required.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_REGIONS=us,eu,kr,tw
BLIZZARD_LOCALE=en_US
BLIZZARD_API_HOST_TEMPLATE=https://{region}.api.blizzard.com
BLIZZARD_PATH_CHARACTER_PROFILE=profile/wow/character/{realmSlug}/{characterName}
BLIZZARD_PATH_CHARACTER_SPECIALIZATIONS=profile/wow/character/{realmSlug}/{characterName}/specializations
BLIZZARD_PATH_CHARACTER_PVP_BRACKET=profile/wow/character/{realmSlug}/{characterName}/pvp-bracket/{bracket}
BLIZZARD_PATH_CHARACTER_MEDIA=profile/wow/character/{realmSlug}/{characterName}/character-media
BLIZZARD_PATH_CHARACTER_PVP_SUMMARY=profile/wow/character/{realmSlug}/{characterName}/pvp-summary
BLIZZARD_PATH_CHARACTER_STATISTICS=profile/wow/character/{realmSlug}/{characterName}/statistics
BLIZZARD_PATH_CHARACTER_EQUIPMENT=profile/wow/character/{realmSlug}/{characterName}/equipment
BLIZZARD_PATH_CHARACTER_ACHIEVEMENTS=profile/wow/character/{realmSlug}/{characterName}/achievements
BLIZZARD_PATH_CHARACTER_ACHIEVEMENT_STATISTICS=profile/wow/character/{realmSlug}/{characterName}/achievements/statistics
BLIZZARD_REQUEST_TIMEOUT_MS=10000
BLIZZARD_RETRY_LIMIT=1
BLIZZARD_HOURLY_LIMIT=36000
BLIZZARD_PER_SECOND_LIMIT=100
BLIZZARD_UTILISATION=0.9

# --- Raider.io (Soulseeker's own key: its own minute window) ------------------
# Required.
RAIDER_IO_API_KEY=
RAIDERIO_API_BASE_URL=https://raider.io/api/v1
RAIDERIO_REGIONS=us,eu,kr,tw,cn
RAIDERIO_PATH_CHARACTER_PROFILE=characters/profile
RAIDERIO_REQUEST_TIMEOUT_MS=10000
RAIDERIO_RETRY_LIMIT=1
RAIDERIO_MINUTE_LIMIT=1000
RAIDERIO_UTILISATION=0.9

# How long a request may wait for the per-second budget window to roll.
BUDGET_WAIT_MS=2000

# --- Rankwarden sync endpoints --------------------------------------------------
# In the cluster: http://rankwarden.rankwarden.svc.cluster.local:3000
RANKWARDEN_BASE_URL=http://localhost:3000
RANKWARDEN_TIMEOUT_MS=10000
RANKWARDEN_SYNC_RETRY_LIMIT=3
RANKWARDEN_SYNC_RETRY_BASE_MS=5000

# --- OAuth 2.0 authorization server (mounted at /oidc) --------------------------
OIDC_ISSUER=http://localhost:3001/oidc
# Required in production; generate with `npm run keys:generate`. Left empty in
# development, a key is generated per process and tokens die with it.
OIDC_JWKS=
OIDC_COOKIE_KEYS=
OIDC_CLIENT_ID=soulseeker-web
OIDC_API_RESOURCE=https://api.rankwarden.local
OIDC_ACCESS_TOKEN_TTL_SECONDS=600
OIDC_REFRESH_TOKEN_TTL_SECONDS=43200
OIDC_SESSION_MAX_SECONDS=2592000
# Exact browser origins of the front end, comma-separated.
CORS_ORIGINS=http://localhost:5173

# --- Anti-scraping on token issuance ------------------------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Rate limits (per minute) -------------------------------------------------
RATE_LIMIT_TOKEN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_API_IP_PER_MINUTE=600

# --- Cache --------------------------------------------------------------------
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_CHARACTER_TTL_SECONDS=900
SEARCH_CACHE_TTL_SECONDS=60
PVP_SEASONS_CACHE_TTL_SECONDS=3600
LEADERBOARD_CACHE_TTL_SECONDS=60
# A PvP character page costs ~13 Blizzard requests: cached 6 h, kept 24 h more
# to serve stale when the budget is spent; forceRefresh once per 5 min per character.
PVP_CHARACTER_CACHE_TTL_SECONDS=21600
PVP_CHARACTER_STALE_SECONDS=86400
PVP_CHARACTER_REFRESH_COOLDOWN_SECONDS=300
PVE_CHARACTER_CACHE_TTL_SECONDS=3600
PVE_CHARACTER_STALE_SECONDS=86400
PVE_CHARACTER_REFRESH_COOLDOWN_SECONDS=300
PVE_CATALOGUE_TTL_SECONDS=86400

# --- Docker (docker compose only; the service ignores it) ---------------------
# Root certificate of a TLS-scanning antivirus or proxy, mounted into the app
# container so it can reach Blizzard and Raider.io. Leave empty if none.
# e.g. DOCKER_EXTRA_CA=C:/ProgramData/Avast Software/Avast/wscert.pem
DOCKER_EXTRA_CA=
